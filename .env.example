# Copy to .env and adjust. Never commit .env.
# All settings use the APP_ prefix.

# Where the SQLite DB, thumbnails, logs and exports live.
# Default: ~/.ai-photo-album/data  (deliberately OUTSIDE OneDrive/Dropbox so
# thumbnails of personal photos are not synced to the cloud).
# APP_DATA_DIR=C:\path\to\data

APP_HOST=127.0.0.1
APP_PORT=8765
APP_LOG_LEVEL=INFO
APP_LOG_JSON=false

# Ingestion
APP_INGEST_WORKERS=0            # 0 = auto (CPU count - 1)
APP_THUMBNAIL_SIZE=480
APP_THUMBNAIL_QUALITY=85

# Duplicate detection (Hamming distance on 64-bit perceptual hashes)
APP_NEAR_DUP_PHASH_THRESHOLD=8
APP_NEAR_DUP_DHASH_THRESHOLD=12

# Quality heuristics (calibrate on real libraries)
APP_BLUR_THRESHOLD=40
# Print suitability (ADR-017) — starting defaults; the print provider's spec overrides them later.
APP_PRINT_EXCELLENT_PPI=300
APP_PRINT_GOOD_PPI=200
APP_PRINT_ACCEPTABLE_PPI=150
# Smallest album slot (w,h in cm); below acceptable PPI even here = "extremely low resolution".
APP_PRINT_MIN_SLOT_CM=[6,9]
