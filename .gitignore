benchmarks/
datasets/
test_data/

# --- Installers / binaries / OS files ---
*.exe
*.msi
*.zip
Thumbs.db
desktop.ini
.DS_Store

# --- Project-management dashboard (dev tooling): live PM state and local requests ---
project_management/state.json
project_management/state.tmp.json
project_management/inbox.jsonl

